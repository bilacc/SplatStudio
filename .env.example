# Optional development overrides.

# PORT=3000
# SPLATSTUDIO_WORKSPACE=C:\Users\You\Documents\SplatStudio

# Optional runtime overrides. If unset, SplatStudio checks bin/<platform>-<arch>
# and bin, then the system PATH.
# FFMPEG_PATH=C:\Tools\ffmpeg\bin\ffmpeg.exe
# COLMAP_PATH=C:\Tools\COLMAP\bin\colmap.exe
# PYTHON_PATH=C:\Tools\Python\python.exe

# Set to 1 if Chromium rendering is unstable on an older or virtual GPU.
# SPLATSTUDIO_DISABLE_GPU=0
# SPLATSTUDIO_OPEN_DEVTOOLS=0
